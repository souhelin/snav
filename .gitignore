# =============================================
#   SNAV BROWSER — .gitignore
# =============================================

# ---------------------------
# Gradle
# ---------------------------
.gradle/
build/
**/build/

# ---------------------------
# Configuração local (SDK path, etc.)
# ---------------------------
local.properties

# ---------------------------
# Logs e arquivos do SO
# ---------------------------
*.log
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------
# Android Studio / IDEA
# ---------------------------
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# ---------------------------
# Outputs gerados pelo build
# ---------------------------
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json
*.ap_

# ---------------------------
# ProGuard
# ---------------------------
proguard/
*.map

# ---------------------------
# Bibliotecas locais (JARs)
# ---------------------------
app/libs/

# ---------------------------
# Keystore e assinatura
# ---------------------------
*.jks
*.keystore
*.p12
*.ks
release/
signing/

# ---------------------------
# Google Services / Firebase
# ---------------------------
google-services.json
google-services-debug.json

# ---------------------------
# Profiling e análise
# ---------------------------
*.hprof
*.profraw
*.profdata

# ---------------------------
# Arquivos de lint
# ---------------------------
lint/
lint-results*
lint-results.xml

# ---------------------------
# Outros
# ---------------------------
*.swp
*.swo
*~
.vscode/
