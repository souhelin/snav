<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#2C3E50"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal"
		android:layout_gravity="center_horizontal|center_vertical"
		android:layout_weight="10">
		<LinearLayout
			android:id="@+id/tela1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:layout_gravity="center_horizontal|center_vertical">
			<TextView
				android:id="@+id/text_icon"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="@string/app_name"
				android:textSize="50sp"
				android:textColor="#FAFAFA" />
			<LinearLayout
				android:id="@+id/linear_barra_pesquisa"
				android:layout_width="350dp"
				android:layout_height="100dp"
				android:layout_margin="5dp"
				android:background="#34495E"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical">
				<EditText
					android:id="@+id/edittext1"
					android:layout_width="match_parent"
					android:layout_height="120dp"
					android:padding="8dp"
					android:gravity="left|center_vertical"
					android:textSize="16sp"
					android:textColor="#FAFAFA"
					android:hint="Insira o que está buscando"
					android:textColorHint="#FAFAFA"
					android:layout_gravity="center_horizontal|center_vertical" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/tela2"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#121212"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:weightSum="1"
			android:layout_gravity="center_horizontal|center_vertical">
			<LinearLayout
				android:id="@+id/linear20"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_gravity="center_horizontal|center_vertical"
				android:layout_weight="1">
				<LinearLayout
					android:id="@+id/linear_tela2_base"
					android:layout_width="match_parent"
					android:layout_height="25dp"
					android:padding="8dp"
					android:background="#34495E"
					android:orientation="horizontal" />
				<LinearLayout
					android:id="@+id/linear_b"
					android:layout_width="match_parent"
					android:layout_height="59dp"
					android:background="#34495E"
					android:gravity="center_horizontal|center_vertical"
					android:layout_gravity="center_horizontal|center_vertical">
					<TextView
						android:id="@+id/text_barra"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:layout_marginLeft="5dp"
						android:layout_marginRight="5dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="Sair do Navegante"
						android:textSize="16sp"
						android:textColor="#ECF0F1"
						android:layout_gravity="center_horizontal|center_vertical"
						android:maxLength="25" />
					<ProgressBar
						android:id="@+id/prog"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:max="1000"
						android:indeterminate="false"
						style="?android:progressBarStyleHorizontal"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/vazio"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="#2C3E50"
					android:gravity="center_horizontal|center_vertical"
					android:orientation="vertical">
					<TextView
						android:id="@+id/text1"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="Sem dados pesquisados no arquivo"
						android:textSize="16sp"
						android:textColor="#9E9E9E"
						android:layout_gravity="center_horizontal|center_vertical" />
					<TextView
						android:id="@+id/text2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="Faça sua primeira pesquisa"
						android:textSize="16sp"
						android:textColor="#ECF0F1"
						android:layout_gravity="center_horizontal|center_vertical" />
				</LinearLayout>
				<WebView
					android:id="@+id/webview"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:background="#34495E"
					android:layout_weight="1" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/tela3"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="#2C3E50"
			android:gravity="center_horizontal|center_vertical"
			android:orientation="vertical"
			android:layout_gravity="center_horizontal|center_vertical">
			<ScrollView
				android:id="@+id/vscroll1"
				android:layout_width="match_parent"
				android:layout_height="match_parent">
				<LinearLayout
					android:id="@+id/linear33"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical">
					<LinearLayout
						android:id="@+id/linear_tela3_base"
						android:layout_width="match_parent"
						android:layout_height="25dp"
						android:padding="8dp"
						android:orientation="horizontal" />
					<LinearLayout
						android:id="@+id/linearmenu2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal">
						<HorizontalScrollView
							android:id="@+id/hscroll1"
							android:layout_width="match_parent"
							android:layout_height="match_parent">
							<LinearLayout
								android:id="@+id/linear25"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:orientation="horizontal">
								<LinearLayout
									android:id="@+id/linear_copiar_URL"
									android:layout_width="wrap_content"
									android:layout_height="match_parent"
									android:layout_margin="5dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:layout_gravity="center_horizontal|center_vertical">
									<ImageView
										android:id="@+id/imageview57"
										android:layout_width="50dp"
										android:layout_height="50dp"
										android:src="@drawable/ic_content_copy_grey"
										android:scaleType="fitCenter"
										android:scaleX="0.5"
										android:scaleY="0.5"
										android:layout_gravity="center_horizontal|center_vertical" />
									<TextView
										android:id="@+id/text14"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:padding="8dp"
										android:gravity="center_horizontal|center_vertical"
										android:text="Capturar\nlink"
										android:textSize="16sp"
										android:textColor="#9E9E9E"
										android:layout_gravity="center_horizontal|center_vertical" />
								</LinearLayout>
								<LinearLayout
									android:id="@+id/linear_tradutor_google"
									android:layout_width="wrap_content"
									android:layout_height="match_parent"
									android:layout_margin="5dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:layout_gravity="center_horizontal|center_vertical">
									<ImageView
										android:id="@+id/imageview63"
										android:layout_width="50dp"
										android:layout_height="50dp"
										android:src="@drawable/ic_translate_grey"
										android:scaleType="fitCenter"
										android:scaleX="0.5"
										android:scaleY="0.5"
										android:layout_gravity="center_horizontal|center_vertical" />
									<TextView
										android:id="@+id/text19"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:padding="8dp"
										android:gravity="center_horizontal|center_vertical"
										android:text="Inter\npretar"
										android:textSize="16sp"
										android:textColor="#9E9E9E"
										android:layout_gravity="center_horizontal|center_vertical" />
								</LinearLayout>
								<LinearLayout
									android:id="@+id/linear_modo_leitura"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_margin="5dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:layout_gravity="center_horizontal|center_vertical">
									<ImageView
										android:id="@+id/imageview92"
										android:layout_width="50dp"
										android:layout_height="50dp"
										android:src="@drawable/icon_text_snippet_round"
										android:scaleType="fitCenter"
										android:scaleX="0.5"
										android:scaleY="0.5"
										android:layout_gravity="center_horizontal|center_vertical" />
									<TextView
										android:id="@+id/text7"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:padding="8dp"
										android:gravity="center_horizontal|center_vertical"
										android:text="Modo\nLeitura"
										android:textSize="16sp"
										android:textColor="#9E9E9E"
										android:layout_gravity="center_horizontal|center_vertical" />
								</LinearLayout>
								<LinearLayout
									android:id="@+id/linear_abrir_no_navegador"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_margin="5dp"
									android:gravity="center_horizontal|center_vertical"
									android:orientation="vertical"
									android:layout_gravity="center_horizontal|center_vertical">
									<ImageView
										android:id="@+id/imageview58"
										android:layout_width="50dp"
										android:layout_height="50dp"
										android:src="@drawable/ic_open_in_browser_grey"
										android:scaleType="fitCenter"
										android:scaleX="0.5"
										android:scaleY="0.5"
										android:layout_gravity="center_horizontal|center_vertical" />
									<TextView
										android:id="@+id/text15"
										android:layout_width="wrap_content"
										android:layout_height="wrap_content"
										android:padding="8dp"
										android:gravity="center_horizontal|center_vertical"
										android:text="Visitar no\nnavegador"
										android:textSize="16sp"
										android:textColor="#9E9E9E"
										android:layout_gravity="center_horizontal|center_vertical" />
								</LinearLayout>
							</LinearLayout>
						</HorizontalScrollView>
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear_escurecer"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_margin="5dp"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical">
						<CheckBox
							android:id="@+id/checkbox_brilho"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="left|center_vertical"
							android:text="Escurecer"
							android:textSize="16sp"
							android:textColor="#9E9E9E"
							android:layout_gravity="center_horizontal|center_vertical" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear_JavaScript"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_margin="5dp"
						android:padding="8dp"
						android:gravity="center_horizontal|center_vertical"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical">
						<CheckBox
							android:id="@+id/checkbox_javascript2"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="left|center_vertical"
							android:text="Javascript"
							android:textSize="16sp"
							android:textColor="#9E9E9E"
							android:checked="true"
							android:layout_gravity="center_horizontal|center_vertical" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/linear_limpar_dados2"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_margin="5dp"
						android:padding="8dp"
						android:gravity="left"
						android:orientation="horizontal"
						android:layout_gravity="center_horizontal|center_vertical">
						<TextView
							android:id="@+id/text5"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:padding="8dp"
							android:gravity="center_horizontal|center_vertical"
							android:text="Limpeza geral"
							android:textSize="16sp"
							android:textColor="#9E9E9E"
							android:layout_gravity="center_horizontal|center_vertical" />
					</LinearLayout>
				</LinearLayout>
			</ScrollView>
		</LinearLayout>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear_c"
		android:layout_width="match_parent"
		android:layout_height="59dp"
		android:padding="8dp"
		android:background="#34495E"
		android:gravity="center_horizontal|center_vertical"
		android:orientation="horizontal"
		android:layout_gravity="center_horizontal|center_vertical">
		<TextView
			android:id="@+id/b1"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="25dp"
			android:layout_marginRight="25dp"
			android:padding="8dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="Navegante"
			android:textSize="16sp"
			android:textColor="#9E9E9E"
			android:layout_gravity="center_horizontal|center_vertical" />
		<TextView
			android:id="@+id/b2"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginLeft="25dp"
			android:layout_marginRight="25dp"
			android:padding="8dp"
			android:gravity="center_horizontal|center_vertical"
			android:text="Ferramenta "
			android:textSize="16sp"
			android:textColor="#9E9E9E"
			android:layout_gravity="center_horizontal|center_vertical" />
	</LinearLayout>
	<LinearLayout
		android:id="@+id/linear82"
		android:layout_width="match_parent"
		android:layout_height="50dp"
		android:padding="8dp"
		android:background="#34495E"
		android:orientation="horizontal" />
</LinearLayout>
