<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/snav_background">

    <LinearLayout
        android:id="@+id/linear1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@color/snav_background">

        <!-- Home / search -->
        <LinearLayout
            android:id="@+id/tela1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@color/snav_background">

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/text_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FAFAFA"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:fontFamily="sans" />

            <LinearLayout
                android:id="@+id/linear_barra_pesquisa"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="8dp"
                android:background="@drawable/snav_search_ripple"
                android:clickable="true"
                android:focusable="true">

                <EditText
                    android:id="@+id/edittext1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="textUri"
                    android:padding="0dp"
                    android:hint="Pesquisar ou inserir endereço"
                    android:textColor="#FAFAFA"
                    android:textColorHint="#D5DDE5"
                    android:textSize="16sp"
                    android:selectAllOnFocus="true" />

                <ImageView
                    android:id="@+id/image_search_action"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ms_search"
                    android:contentDescription="Pesquisar"
                    android:tint="@color/snav_accent" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1.2" />
        </LinearLayout>

        <!-- Browser -->
        <LinearLayout
            android:id="@+id/tela2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/snav_surface">

            <LinearLayout
                android:id="@+id/linear20"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/snav_surface">

                <LinearLayout
                    android:id="@+id/linear_tela2_base"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:orientation="horizontal"
                    android:background="@color/snav_surface" />

                <LinearLayout
                    android:id="@+id/linear_b"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@color/snav_surface">

                    <ImageButton
                        android:id="@+id/button_site_info"
                        android:layout_width="40dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Informações do site"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ms_tune"
                        android:tint="#757575" />

                    <TextView
                        android:id="@+id/text_barra"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:ellipsize="middle"
                        android:text="Snav Browser"
                        android:textColor="@color/snav_on_surface"
                        android:textSize="15sp"
                        android:fontFamily="sans-medium" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/prog"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progressTint="@color/snav_primary"
                    android:indeterminateTint="@color/snav_primary"
                    android:progressBackgroundTint="@color/snav_outline"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:contentDescription="Carregamento da página" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/snav_outline" />

                <LinearLayout
                    android:id="@+id/vazio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp"
                    android:background="@color/snav_surface">

                    <TextView
                        android:id="@+id/text1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nenhuma página aberta"
                        android:textColor="@color/snav_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text2"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:padding="8dp"
                        android:text="Toque para voltar à pesquisa"
                        android:textColor="@color/snav_on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>

                <WebView
                    android:id="@+id/webview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/snav_surface" />
            </LinearLayout>
        </LinearLayout>

        <!-- Browser tools -->
        <LinearLayout
            android:id="@+id/tela3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/snav_background">

            <ScrollView
                android:id="@+id/vscroll1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/linear33"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:id="@+id/linear_tela3_base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ferramentas"
                            android:textColor="@color/snav_on_surface"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linearmenu2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <HorizontalScrollView
                            android:id="@+id/hscroll1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:clipToPadding="false"
                            android:clipChildren="false"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <LinearLayout
                                android:id="@+id/linear25"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:paddingStart="0dp"
                                android:paddingEnd="0dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="18dp">

                                <LinearLayout
                                    android:id="@+id/linear_copiar_URL"
                                    android:layout_width="72dp"
                                    android:layout_height="92dp"
                                    android:layout_marginEnd="8dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="@drawable/snav_tool_ripple"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <ImageView
                                        android:id="@+id/imageview57"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/ms_content_copy"
                                        android:tint="@color/snav_on_surface_variant"
                                        android:contentDescription="Copiar link"
                                        android:scaleType="fitCenter" />
                                    <TextView
                                        android:id="@+id/text14"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Copiar link"
                                        android:textColor="@color/snav_on_surface"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/linear_tradutor_google"
                                    android:layout_width="72dp"
                                    android:layout_height="92dp"
                                    android:layout_marginEnd="8dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="@drawable/snav_tool_ripple"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <ImageView
                                        android:id="@+id/imageview63"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/ms_translate"
                                        android:tint="@color/snav_on_surface_variant"
                                        android:contentDescription="Traduzir página"
                                        android:scaleType="fitCenter" />
                                    <TextView
                                        android:id="@+id/text19"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Traduzir"
                                        android:textColor="@color/snav_on_surface"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/linear_modo_leitura"
                                    android:layout_width="72dp"
                                    android:layout_height="92dp"
                                    android:layout_marginEnd="8dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="@drawable/snav_tool_ripple"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <ImageView
                                        android:id="@+id/imageview92"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/ms_text_snippet"
                                        android:tint="@color/snav_on_surface_variant"
                                        android:contentDescription="Modo de leitura"
                                        android:scaleType="fitCenter" />
                                    <TextView
                                        android:id="@+id/text7"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Leitura"
                                        android:textColor="@color/snav_on_surface"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/linear_abrir_no_navegador"
                                    android:layout_width="72dp"
                                    android:layout_height="92dp"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:background="@drawable/snav_tool_ripple"
                                    android:clickable="true"
                                    android:focusable="true">
                                    <ImageView
                                        android:id="@+id/imageview58"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/ms_open_in_browser"
                                        android:tint="@color/snav_on_surface_variant"
                                        android:contentDescription="Abrir em outro navegador"
                                        android:scaleType="fitCenter" />
                                    <TextView
                                        android:id="@+id/text15"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Abrir fora"
                                        android:textColor="@color/snav_on_surface"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="Preferências"
                        android:textColor="@color/snav_on_surface"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/linear_escurecer"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/checkbox_brilho"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            style="@style/SnavMaterialSwitch"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:text="Escurecer páginas"
                            android:textColor="@color/snav_on_surface"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_JavaScript"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/checkbox_javascript2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            style="@style/SnavMaterialSwitch"
                            android:minHeight="48dp"
                            android:checked="true"
                            android:gravity="center_vertical"
                            android:text="JavaScript"
                            android:textColor="@color/snav_on_surface"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/snav_outline" />

                    <LinearLayout
                        android:id="@+id/linear_limpar_dados2"
                        android:background="?android:attr/selectableItemBackground"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/text5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:text="Limpar dados de navegação"
                            android:textColor="@color/snav_error"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Compact bottom navigation -->
    <LinearLayout
        android:id="@+id/linear_c"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/snav_surface"
        android:elevation="4dp">

        <TextView
            android:id="@+id/b1"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text=""
            android:drawableTop="@drawable/ms_home"
            android:drawableTint="@color/snav_primary"
            android:contentDescription="Início"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:id="@+id/b2"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text=""
            android:drawableTop="@drawable/ms_build"
            android:drawableTint="@color/snav_on_surface_variant"
            android:contentDescription="Ferramentas"
            android:gravity="center"
            android:padding="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linear82"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:background="@color/snav_surface" />
</LinearLayout>
