<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:colorControlHighlight">@color/colorControlHighlight</item>
        <item name="android:colorControlNormal">@color/colorControlNormal</item>
        <item name="colorPrimary">@color/snav_accent</item>
        <item name="colorOnPrimary">#301800</item>
        <item name="colorPrimaryContainer">@color/snav_switch_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/snav_on_surface</item>
        <item name="colorSurface">@color/snav_surface</item>
        <item name="colorOnSurface">@color/snav_on_surface</item>
        <item name="colorSurfaceVariant">@color/snav_outline</item>
        <item name="colorOnSurfaceVariant">@color/snav_on_surface_variant</item>
        <item name="colorOutline">@color/snav_on_surface_variant</item>
        <item name="colorSecondary">@color/snav_primary</item>
        <item name="colorOutlineVariant">@color/snav_outline</item>
        <item name="colorError">@color/snav_error</item>
        <item name="android:colorBackground">@color/snav_background</item>
        <item name="bottomSheetDialogTheme">@style/SnavBottomSheetDialog</item>
        <item name="android:statusBarColor">@color/snav_background</item>
        <item name="android:navigationBarColor">@color/snav_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="SnavBottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SnavModalBottomSheet</item>
    </style>

    <style name="SnavModalBottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="shapeAppearance">@style/SnavBottomSheetShape</item>
    </style>

    <style name="SnavBottomSheetShape" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="FullScreen" parent="@style/AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="NoActionBar" parent="@style/AppTheme" />
    <style name="NoStatusBar" parent="@style/AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="AppTheme.DebugActivity" parent="@style/AppTheme" />

</resources>